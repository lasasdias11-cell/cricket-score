rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    match /teams/{id} { allow read, write: if isSignedIn(); }
    match /matches/{id} { allow read, write: if isSignedIn(); }
    match /players/{id} { allow read, write: if isSignedIn(); }
    match /customTeams/{id} { allow read, write: if isSignedIn(); }
    match /teamVotes/{id} { allow read, write: if isSignedIn(); }
    match /users/{id} { allow read, write: if isSignedIn(); }
    match /{document=**} { allow read, write: if false; }
  }
}
