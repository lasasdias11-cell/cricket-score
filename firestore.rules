rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /teams/{teamId} { allow read, write: if isSignedIn(); }
    match /matches/{matchId} { allow read, write: if isSignedIn(); }
    match /players/{playerId} { allow read, write: if isSignedIn(); }
    match /customTeams/{teamId} { allow read, write: if isSignedIn(); }
    match /teamVotes/{voteId} { allow read, write: if isSignedIn(); }
    match /users/{userId} { allow read, write: if isSignedIn(); }
    
    match /{document=**} { allow read, write: if false; }
  }
}
