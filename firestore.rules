rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Teams Collection (White Tigers, Black Panthers, etc.)
    match /teams/{teamId} {
      allow read, write: if isSignedIn();
    }

    // 2. Matches Collection (Live scoring, scorecards, innings)
    match /matches/{matchId} {
      allow read, write: if isSignedIn();
    }

    // 3. Players Collection (Player profiles, tags, stats)
    match /players/{playerId} {
      allow read, write: if isSignedIn();
    }

    // 4. Custom Teams Collection (Dynamic teams created in-app)
    match /customTeams/{teamId} {
      allow read, write: if isSignedIn();
    }

    // 5. Team Votes Collection (Captain elections, secret code changes)
    match /teamVotes/{voteId} {
      allow read, write: if isSignedIn();
    }

    // 6. Users Collection (Session metadata)
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // 7. Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
