rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    match /teams/{document=**} { allow read, write: if isAuth(); }
    match /customTeams/{document=**} { allow read, write: if isAuth(); }
    match /matches/{document=**} { allow read, write: if isAuth(); }
    match /players/{document=**} { allow read, write: if isAuth(); }
    match /teamVotes/{document=**} { allow read, write: if isAuth(); }
  }
}
